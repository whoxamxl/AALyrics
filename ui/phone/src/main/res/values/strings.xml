    <string name="settings_section_reset">RESET</string>
    <string name="settings_reset_aalyrics">Reset AALyrics</string>
    <string name="settings_reset_aalyrics_info">Restores AALyrics settings and onboarding state to their defaults, cancels app-owned update work, clears update recovery state, and removes downloaded app update files. Downloaded translation models, Android permissions, install-source permission, and Android Auto system settings are not changed.</string>
