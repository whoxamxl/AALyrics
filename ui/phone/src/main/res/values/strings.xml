    <string name="settings_reset_aalyrics_dialog_title">Reset AALyrics?</string>
    <string name="settings_reset_aalyrics_dialog_body">AALyrics settings and onboarding state will be restored to their defaults, active app-owned update work will be cancelled, update recovery state will be cleared, and downloaded app update files will be removed. Downloaded translation models and system settings, including install-source permission, will not be changed.</string>
