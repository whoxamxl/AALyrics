    <string name="notification_access_eyebrow">REQUIRED SYSTEM ACCESS</string>
    <string name="notification_access_title">Setup required</string>
    <string name="notification_access_body">AALyrics needs Notification Access to detect the music currently playing on this device and load synchronized lyrics.</string>
    <string name="notification_access_reason">Android keeps this access under system settings. AALyrics checks the real system state again when you return.</string>
    <string name="notification_access_grant">Grant notification access</string>
    <string name="notification_access_footer">You can disable this access at any time in Android Settings.</string>

    <string name="android_auto_compat_eyebrow">ANDROID AUTO COMPATIBILITY</string>
    <string name="android_auto_compat_title">Enable legacy fallback</string>
    <string name="android_auto_compat_body">AALyrics keeps a legacy Android Auto media fallback for compatibility. Because this build is installed outside Google Play, enable Android Auto Developer Mode and Unknown sources to use that fallback.</string>
    <string name="android_auto_compat_step_1">Open Android Auto settings.</string>
    <string name="android_auto_compat_step_2">Open Version, then tap Version and permission info 10 times to enable Developer Mode.</string>
    <string name="android_auto_compat_step_3">Open Developer settings from the Android Auto menu.</string>
    <string name="android_auto_compat_step_4">Enable Unknown sources.</string>
    <string name="android_auto_compat_verification_note">Android Auto does not expose this setting to AALyrics, so it cannot be verified automatically.</string>
    <string name="android_auto_compat_enabled">I’ve enabled Unknown sources</string>
    <string name="android_auto_compat_skip">Continue without it</string>
    <string name="android_auto_compat_footer">This setup is only for the legacy sideloaded media fallback. The templated Car App Library path does not require Android Auto Unknown sources.</string>

    <string name="settings_title">Settings</string>
    <string name="settings_section_lyrics">LYRICS</string>
    <string name="settings_plain_auto_scroll">Plain lyrics auto-scroll</string>
    <string name="settings_plain_auto_scroll_info">Estimates where playback is in untimed lyrics and scrolls smoothly to match. Requires track duration.</string>
    <string name="settings_plain_auto_scroll_info_description">About Plain lyrics auto-scroll</string>
    <string name="settings_ignore_non_audio_apps">Ignore non-audio apps</string>
    <string name="settings_ignore_non_audio_apps_info">Only apps Android identifies as audio apps are used for lyrics lookup. This prevents unnecessary searches from games, browsers, social apps, and other media sources. Unclassified apps are blocked unless allowed in Advanced settings.</string>
    <string name="settings_ignore_non_audio_apps_info_description">About ignoring non-audio apps</string>

